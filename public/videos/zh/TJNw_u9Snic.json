   "start": 1040.23,
   "end": 1044.3,
   "zh": "没事，谁都有这样的时候。",
   "es": "No pasa nada, todos tenemos días así."
  },
  {
   "start": 1045.37,
   "end": 1049.1,
   "zh": "谢谢您，您很好！",
   "es": "¡Gracias, usted es muy amable!"
  },
  {
   "start": 1050.13,
   "end": 1053.07,
   "zh": "哎，不用谢。",
   "es": "Ah, no hay de qué."
  },
  {
   "start": 1054.1,
   "end": 1057.53,
   "zh": "到了，多少钱？",
   "es": "Hemos llegado, ¿cuánto es?"
  },
  {
   "start": 1058.57,
   "end": 1061.1,
   "zh": "十八块。",
   "es": "Dieciocho yuanes."
  },
  {
   "start": 1062.17,
   "end": 1065.73,
   "zh": "好，我扫码付。",
   "es": "Muy bien, pagaré escaneando el código."
  },
  {
   "start": 1066.77,
   "end": 1069.73,
   "zh": "好，收到了。",
   "es": "Muy bien, recibido."
  },
  {
   "start": 1070.77,
   "end": 1075.1,
   "zh": "下次我不忘带钱包了！",
   "es": "¡La próxima vez no olvidaré mi billetera!"
  },
  {
   "start": 1076.17,
   "end": 1080.6,
   "zh": "哈哈，好好！再见！",
   "es": "Jaja, ¡muy bien! ¡Adiós!"
  },
  {
   "start": 1081.63,
   "end": 1084.83,
   "zh": "再见，谢谢您！",
   "es": "¡Adiós, gracias!"
  },
  {
   "start": 1087.97,
   "end": 1089.8,
   "zh": "去医院",
   "es": "Ir al hospital"
  },
  {
   "start": 1093.7,
   "end": 1098.93,
   "zh": "师傅，麻烦您送我去医院。",
   "es": "Conductor, por favor, lléveme al hospital."
  },
