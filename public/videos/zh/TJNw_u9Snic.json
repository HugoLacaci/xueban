   "zh": "对！我很喜欢北京烤鸭！",
   "es": "¡Sí! ¡Me encanta el pato laqueado!"
  },
  {
   "start": 916.63,
   "end": 919.5,
   "zh": "哈哈，好！",
   "es": "Jaja, ¡genial!"
  },
  {
   "start": 920.57,
   "end": 924.27,
   "zh": "到国贸要多久？",
   "es": "¿Cuánto falta para llegar al Centro de Comercio?"
  },
