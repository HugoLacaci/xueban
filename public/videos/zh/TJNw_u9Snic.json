  {
   "start": 795.03,
   "end": 799.3,
   "zh": "对！前面就是东站了。",
   "es": "¡Sí! Más adelante está la Estación Este."
  },
  {
   "start": 800.37,
   "end": 805,
   "zh": "好，到了！谢谢你帮我导航！",
   "es": "Bien, hemos llegado. ¡Gracias por ayudarme a navegar!"
  },
  {
   "start": 806.03,
   "end": 810.37,
   "zh": "哈哈，不客气！多少钱？",
   "es": "Jaja, ¡de nada! ¿Cuánto es?"
  },
  {
   "start": 811.4,
   "end": 814.2,
   "zh": "二十九块。",
   "es": "Veintinueve yuanes."
  },
  {
   "start": 815.27,
   "end": 819.77,
   "zh": "好，给你三十，不用找了。",
   "es": "Bien, aquí tiene treinta, quédese con el cambio."
  },
  {
   "start": 820.87,
   "end": 824.6,
   "zh": "谢谢！你一路平安！",
   "es": "¡Gracias! ¡Buen viaje!"
  },
  {
   "start": 827.9,
   "end": 830.43,
   "zh": "在机场打车",
   "es": "Tomando un taxi en el aeropuerto"
  },
  {
   "start": 834.27,
   "end": 837.47,
   "zh": "师傅，你好！",
   "es": "¡Hola, conductor!"
  },
  {
   "start": 838.5,
   "end": 841.97,
   "zh": "你好！去哪儿？",
   "es": "¡Hola! ¿A dónde va?"
  },
  {
   "start": 843.03,
   "end": 847.2,
   "zh": "去市中心，国贸那边。",
   "es": "Al centro de la ciudad, por el Centro de Comercio Internacional."
  },
  {
   "start": 848.23,
   "end": 852.43,
   "zh": "好，行李放后面吧。",
   "es": "Bien, ponga su equipaje en el maletero."
  },
  {
   "start": 853.5,
   "end": 856.77,
   "zh": "好的，谢谢您！",
   "es": "Muy bien, ¡gracias!"
  },
  {
   "start": 857.8,
   "end": 861.53,
   "zh": "你是从外地来的？",
   "es": "¿Viene de fuera de la ciudad?"
  },
  {
   "start": 862.6,
   "end": 866.47,
   "zh": "对，我从上海来的。",
   "es": "Sí, vengo de Shanghái."
  },
  {
   "start": 867.53,
   "end": 872.17,
   "zh": "哦！上海来北京出差？",
   "es": "¡Ah! ¿De Shanghái a Pekín por negocios?"
