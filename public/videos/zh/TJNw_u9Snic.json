   "end": 719.63,
   "zh": "嗯……我不太清楚那里。",
   "es": "Hmm... no estoy muy familiarizado con esa zona."
  },
  {
   "start": 720.67,
   "end": 724.7,
   "zh": "没关系，我帮你导航。",
   "es": "No pasa nada, yo le guiaré."
  },
  {
   "start": 725.7,
   "end": 729.8,
   "zh": "好的，那太好了，谢谢！",
   "es": "Muy bien, eso es genial, ¡gracias!"
  },
  {
   "start": 730.87,
   "end": 733.9,
   "zh": "现在直走。",
   "es": "Siga recto ahora."
  },
  {
   "start": 734.97,
   "end": 738.07,
   "zh": "好，直走。",
   "es": "Muy bien, sigo recto."
  },
  {
   "start": 739.13,
   "end": 742.2,
   "zh": "前面右转。",
   "es": "Gire a la derecha más adelante."
  },
  {
   "start": 743.23,
   "end": 746.33,
   "zh": "这里右转吗？",
   "es": "¿Girar a la derecha aquí?"
  },
  {
   "start": 747.4,
   "end": 750.5,
   "zh": "对，就是这里。",
   "es": "Sí, justo aquí."
  },
  {
   "start": 751.57,
   "end": 755.4,
   "zh": "好，转了。然后？",
   "es": "Muy bien, ya giré. ¿Luego?"
  },
