   "start": 771.1,
   "end": 775.03,
   "zh": "我才来这里工作三个月。",
   "es": "Solo llevo tres meses trabajando aquí."
  },
  {
   "start": 776.1,
   "end": 780.2,
   "zh": "哦，所以不太清楚路。",
   "es": "Ah, por eso no conoce bien el camino."
  },
  {
   "start": 781.23,
   "end": 784.67,
   "zh": "对，不好意思啊。",
   "es": "Sí, perdone las molestias."
  },
  {
   "start": 785.73,
   "end": 789.3,
   "zh": "没关系，我也不熟。",
   "es": "No se preocupe, yo tampoco conozco bien."
  },
  {
   "start": 790.33,
   "end": 793.97,
   "zh": "左转了，是这里吗？",
   "es": "Ya giré a la izquierda, ¿es aquí?"
