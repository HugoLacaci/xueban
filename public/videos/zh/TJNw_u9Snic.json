   "start": 756.43,
   "end": 760.7,
   "zh": "走三百米，再左转。",
   "es": "Avance trescientos metros, luego gire a la izquierda."
  },
  {
   "start": 761.77,
   "end": 764.9,
   "zh": "好，明白了。",
   "es": "Muy bien, entendido."
  },
  {
   "start": 765.97,
   "end": 770.07,
   "zh": "我来广州不多，你呢？",
   "es": "No llevo mucho tiempo en Cantón, ¿y usted?"
