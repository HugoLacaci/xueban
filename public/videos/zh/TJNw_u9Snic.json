  {
   "start": 901.2,
   "end": 904.5,
   "zh": "是啊，不好吃。",
   "es": "Sí, no es muy buena."
  },
  {
   "start": 905.53,
   "end": 910.1,
   "zh": "到了北京，要吃北京烤鸭！",
