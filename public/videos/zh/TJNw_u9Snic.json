  {
   "start": 940.33,
   "end": 944.1,
   "zh": "到了叫我一下，好吗？",
   "es": "Avíseme cuando lleguemos, ¿de acuerdo?"
  },
  {
   "start": 945.13,
   "end": 948.17,
   "zh": "好，没问题。",
   "es": "Sí, no hay problema."
  },
  {
   "start": 949.23,
   "end": 951.73,
   "zh": "谢谢您！",
   "es": "¡Gracias!"
  },
  {
   "start": 952.77,
   "end": 956.27,
   "zh": "不客气，好好休息！",
   "es": "De nada, ¡descanse bien!"
  },
  {
   "start": 959.3,
   "end": 961.43,
   "zh": "忘了带钱包",
