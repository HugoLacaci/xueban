   "start": 965.3,
   "end": 969.4,
   "zh": "师傅，不好意思！",
   "es": "¡Conductor, lo siento mucho!"
  },
  {
   "start": 970.4,
   "end": 972.7,
   "zh": "怎么了？",
   "es": "¿Qué pasa?"
