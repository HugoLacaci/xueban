   "start": 1099.97,
   "end": 1103.57,
   "zh": "好的，哪个医院？",
   "es": "Muy bien, ¿a qué hospital?"
  },
  {
   "start": 1104.63,
   "end": 1108.9,
   "zh": "协和医院，您知道吗？",
   "es": "Al Hospital de la Unión Médica de Pekín, ¿lo conoce?"
  },
  {
   "start": 1109.9,
   "end": 1114.27,
   "zh": "知道知道，很近，您放心。",
   "es": "Lo conozco, está muy cerca, no se preocupe."
  },
  {
   "start": 1115.33,
   "end": 1118.6,
   "zh": "好，谢谢你。",
   "es": "Muy bien, gracias."
  },
  {
   "start": 1119.67,
   "end": 1123.77,
   "zh": "大妈，您身体不舒服吗？",
   "es": "Señora, ¿no se siente bien?"
  },
  {
   "start": 1124.8,
   "end": 1128.87,
   "zh": "是啊，我头有点儿疼。",
   "es": "Sí, me duele un poco la cabeza."
  },
  {
   "start": 1129.9,
   "end": 1133.43,
   "zh": "哎，那要多注意。",
   "es": "Ah, debería tener más cuidado."
