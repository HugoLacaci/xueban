  {
   "start": 873.17,
   "end": 877.03,
   "zh": "对，来开两天会。",
   "es": "Sí, vengo a una reunión de dos días."
  },
  {
   "start": 878.1,
   "end": 881.4,
   "zh": "哎，辛苦了！",
   "es": "¡Vaya, debe estar agotado!"
  },
  {
   "start": 882.47,
   "end": 885.83,
   "zh": "没事，习惯了。",
   "es": "No pasa nada, estoy acostumbrado."
  },
  {
   "start": 886.87,
   "end": 890.37,
   "zh": "飞机上吃东西了吗？",
   "es": "¿Comió algo en el avión?"
  },
  {
   "start": 891.4,
   "end": 895.3,
   "zh": "吃了，但是不好吃。",
   "es": "Sí, pero no estaba muy bueno."
  },
  {
   "start": 896.37,
   "end": 900.17,
   "zh": "哈哈，飞机上的饭嘛……",
   "es": "Jaja, bueno, la comida de avión..."
