  "items": [
    {
      "id": "g-question-words-001",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 1,
      "zh": "你是＿国人？",
      "answer": "哪",
      "options": ["哪", "什么", "谁", "几"],
      "es": "¿De qué país eres?",
      "py": "Nǐ shì nǎ guó rén?",
      "grammarIds": ["question-words"],
      "explain": "«¿Cuál país?» se dice con 哪 + nombre (哪国). 什么 pregunta «qué» en general y 谁 «quién»."
    },
    {
      "id": "g-question-words-002",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 1,
      "zh": "现在＿点？",
      "answer": "几",
      "options": ["几", "多少", "什么", "怎么"],
      "es": "¿Qué hora es?",
      "py": "Xiànzài jǐ diǎn?",
      "grammarIds": ["question-words", "dates-time"],
      "explain": "Las horas son números pequeños con clasificador (点), así que se pregunta con 几, no con 多少."
    },
    {
      "id": "g-question-words-003",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 1,
      "zh": "这个＿钱？",
      "answer": "多少",
      "options": ["多少", "几", "什么", "怎么样"],
      "es": "¿Cuánto cuesta esto?",
      "py": "Zhège duōshao qián?",
      "grammarIds": ["question-words"],
      "explain": "El precio puede ser cualquier cantidad y 钱 va sin clasificador: por eso 多少钱 y no 几钱."
    },
    {
      "id": "g-question-words-004",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 1,
      "zh": "你去＿？",
      "answer": "哪儿",
      "options": ["哪儿", "哪", "什么", "谁"],
      "es": "¿Adónde vas?",
      "py": "Nǐ qù nǎr?",
      "grammarIds": ["question-words", "demonstratives"],
      "explain": "«Dónde / adónde» es 哪儿 (哪 + 儿). 哪 solo significa «cuál» y necesita un clasificador o nombre detrás."
    },
    {
      "id": "g-question-words-005",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 2,
      "zh": "你家有＿口人？",
      "answer": "几",
      "options": ["几", "多少", "什么", "哪"],
      "es": "¿Cuántas personas hay en tu familia?",
      "py": "Nǐ jiā yǒu jǐ kǒu rén?",
      "grammarIds": ["question-words", "measure-words"],
      "explain": "Se espera un número pequeño y hay clasificador (口): 几口人. 多少 se usa para cantidades grandes o desconocidas."
    },
    {
