      "id": "g-modal-verbs-001",
      "type": "fill-blank",
      "skill": "grammar",
      "level": 1,
      "zh": "我＿说汉语。",
      "answer": "会",
      "options": ["会", "可以", "要", "是"],
      "es": "Sé hablar chino.",
      "py": "Wǒ huì shuō Hànyǔ.",
      "grammarIds": ["modal-verbs"],
      "explain": "Una habilidad aprendida (idiomas, nadar, conducir) se expresa con 会. 可以 es permiso y 要 es querer."
    },
